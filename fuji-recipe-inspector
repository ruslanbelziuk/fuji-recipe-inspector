#!/usr/bin/env bash

set -euo pipefail

# Script: fuji-recipe-inspector
# Description: Extract EXIF data from images and convert to Fuji FP1 XML format

VERSION="0.0.1-dev"

show_help() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS] IMAGE_FILE

Extract EXIF data from images and convert to Fuji FP1 XML format.

OPTIONS:
    --xml           Generate FP1 XML from image (output to stdout)
    --debug         Output all available EXIF data (raw format)
    --help, -h      Show this help message and exit

ARGUMENTS:
    IMAGE_FILE      Path to the image file to process

EXAMPLES:
    # Compare image recipe with existing FP1 files (shows 100% matches only)
    $(basename "$0") photo.jpg

    # Generate FP1 XML from image
    $(basename "$0") --xml photo.jpg > recipe.FP1

    # Debug mode - show all EXIF data
    $(basename "$0") --debug photo.jpg

REQUIREMENTS:
    - exiftool must be installed
      macOS: brew install exiftool
      Linux: apt-get install libimage-exiftool-perl (Debian/Ubuntu)
             yum install perl-Image-ExifTool (RHEL/CentOS)

EOF
}

check_dependencies() {
    if ! command -v exiftool &> /dev/null; then
        echo "Error: exiftool is not installed" >&2
        echo "" >&2
        echo "Install it with:" >&2
        if [[ "$OSTYPE" == "darwin"* ]]; then
            echo "  brew install exiftool" >&2
        elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
            echo "  Debian/Ubuntu: sudo apt-get install libimage-exiftool-perl" >&2
            echo "  RHEL/CentOS:   sudo yum install perl-Image-ExifTool" >&2
        fi
        exit 1
    fi
}

debug_mode() {
    local image_file="$1"

    if [[ ! -f "$image_file" ]]; then
        echo "Error: File not found: $image_file" >&2
        exit 1
    fi

    echo "=== Fujifilm EXIF Data for: $image_file ===" >&2
    echo "" >&2
    exiftool -Fujifilm:all "$image_file"
}

# Extract all EXIF data in JSON format for efficient access
extract_exif_json() {
    local image_file="$1"
    
    if [ ! -f "$image_file" ]; then
        echo "Error: File not found: $image_file" >&2
        exit 1
    fi
    
    # Use exiftool to extract all EXIF data in JSON format
    exiftool -json -groupNames -s3 "$image_file" 2>/dev/null || echo "[]"
}

# Parse JSON value using shell-compatible approach
parse_json_value() {
    local json_data="$1"
    local key="$2"
    local default="${3:-}"
    
    # Use a simple grep-based approach to extract values from JSON
    # This works with the exiftool JSON output format
    local value=$(echo "$json_data" | grep -o "\"$key\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 | sed 's/.*:[[:space:]]*"\([^"]*\)".*/\1/')
    
    # If no quoted value found, try unquoted numeric/boolean values
    if [ -z "$value" ]; then
        value=$(echo "$json_data" | grep -o "\"$key\"[[:space:]]*:[[:space:]]*[^,}]*" | head -1 | sed 's/.*:[[:space:]]*//' | sed 's/[[:space:]]*$//')
    fi
    
    echo "${value:-$default}"
}

get_exif_value() {
    local exif_data="$1"
    local tag="$2"
    local default="${3:-}"
    local uppercase="${4:-false}"
    local category="${5:-MakerNotes}"
    
    # Try with category prefix first
    local full_tag="${category}:${tag}"
    local value=$(parse_json_value "$exif_data" "$full_tag" "")

    if [[ -z "$value" ]]; then
        echo "$default"
    else
        if [[ "$uppercase" == "true" ]]; then
            echo "$value" | tr '[:lower:]' '[:upper:]'
        else
            echo "$value"
        fi
    fi
}

extract_numeric() {
    local value="$1"
    # Extract numeric part, handling "+3 (very high)" -> "3", " -4 (lowest)" -> "-4"
    local num=$(echo "$value" | grep -oE '[+-]?[0-9]+\.?[0-9]*' | head -1)
    # Strip leading + sign if present
    num="${num#+}"
    echo "${num:-$value}"
}

format_exposure_bias() {
    local value="$1"

    # Handle zero or empty
    if [[ -z "$value" ]] || [[ "$value" == "0" ]] || [[ "$value" == "0.0" ]]; then
        echo "0"
        return
    fi

    # Determine sign
    local sign="P"
    if [[ "$value" == -* ]]; then
        sign="M"
        value="${value#-}"  # Remove negative sign
    fi

    # Split into integer and decimal parts
    local int_part="${value%%.*}"
    local dec_part="${value#*.}"

    # Handle case where there's no decimal point
    if [[ "$int_part" == "$dec_part" ]]; then
        dec_part="00"
    else
        # Ensure decimal part is 2 digits, pad or truncate
        dec_part="${dec_part}00"
        dec_part="${dec_part:0:2}"
    fi

    echo "${sign}${int_part}P${dec_part}"
}

parse_wb_shift() {
    local wb_fine_tune="$1"
    local color="$2"  # "red" or "blue"

    # Extract Red or Blue value from "Red +0, Blue +0" format
    local pattern
    if [[ "$color" == "red" ]]; then
        pattern='Red ([+-]?[0-9]+)'
    else
        pattern='Blue ([+-]?[0-9]+)'
    fi

    local value=$(echo "$wb_fine_tune" | grep -oE "$pattern" | grep -oE '[+-]?[0-9]+')

    # Convert to WB shift by dividing by 20
    if [[ -n "$value" ]]; then
        echo $((value / 20))
    else
        echo "0"
    fi
}

map_film_simulation() {
    local film=$(echo "$1" | tr '[:upper:]' '[:lower:]')

    case "$film" in
        *"provia"*) echo "Provia" ;;
        *"velvia"*) echo "Velvia" ;;
        *"astia"*) echo "Astia" ;;
        *"classic chrome"*) echo "Classic" ;;
        *"pro neg"*"hi"*) echo "NEGAhi" ;;
        *"pro neg"*"std"*) echo "NEGAStd" ;;
        *"classic neg"*) echo "ClassicNEGA" ;;
        *"eterna"*) echo "Eterna" ;;
        *"bleach bypass"*) echo "BleachBypass" ;;
        *"nostalgic neg"*) echo "NostalgicNEGA" ;;
        *"reala"*) echo "Reala" ;;
        *"acros"*) echo "Acros" ;;
        *"acros+r"*|*"acros r"*) echo "AcrosR" ;;
        *"acros+g"*|*"acros g"*) echo "AcrosG" ;;
        *"acros+ye"*|*"acros ye"*) echo "AcrosYe" ;;
        *"sepia"*) echo "Sepia" ;;
        *"b&w"*|*"bw"*|*"monochrome"*) echo "BW" ;;
        *"b&w+r"*|*"bw+r"*) echo "BR" ;;
        *"b&w+g"*|*"bw+g"*) echo "BG" ;;
        *"b&w+ye"*|*"bw+ye"*) echo "BYe" ;;
        *) echo "" ;;
    esac
}

map_saturation_bw() {
    local saturation=$(echo "$1" | tr '[:upper:]' '[:lower:]')

    case "$saturation" in
        *"acros yellow"*) echo "AcrosYe" ;;
        *"acros red"*) echo "AcrosR" ;;
        *"acros green"*) echo "AcrosG" ;;
        *"acros"*) echo "Acros" ;;
        *"b&w yellow"*|*"bw yellow"*) echo "BYe" ;;
        *"b&w red"*|*"bw red"*) echo "BR" ;;
        *"b&w green"*|*"bw green"*) echo "BG" ;;
        *"b&w sepia"*|*"bw sepia"*) echo "Sepia" ;;
        *"none (b&w)"*) echo "BW" ;;
        *) echo "" ;;
    esac
}

map_white_balance() {
    local wb=$(echo "$1" | tr '[:upper:]' '[:lower:]')

    case "$wb" in
        *"auto (white priority)"*|*"auto white"*) echo "Auto_White" ;;
        *"auto (ambiance priority)"*|*"auto ambiance"*) echo "Auto_Ambience" ;;
        *"auto"*) echo "Auto" ;;
        *"custom3"*) echo "Custom3" ;;
        *"custom2"*) echo "Custom2" ;;
        *"custom"*) echo "Custom1" ;;
        *"kelvin"*) echo "Temperature" ;;
        *"daylight fluorescent"*) echo "FLight1" ;;
        *"day white fluorescent"*) echo "FLight2" ;;
        *"white fluorescent"*) echo "FLight3" ;;
        *"daylight"*) echo "Daylight" ;;
        *"cloudy"*) echo "Shade" ;;
        *"incandescent"*) echo "Incand" ;;
        *"underwater"*) echo "UWater" ;;
        *) echo "Auto" ;;
    esac
}

generate_fp1() {
    local image_file="$1"

    if [[ ! -f "$image_file" ]]; then
        echo "Error: File not found: $image_file" >&2
        exit 1
    fi

    # Extract all EXIF data once in JSON format
    local exif_data
    exif_data=$(extract_exif_json "$image_file")

    # Extract EXIF data using the optimized function
    local fuji_model=$(get_exif_value "$exif_data" "FujiModel" "")
    local camera_model="${fuji_model%%_*}"  # Extract camera name before underscore
    if [[ -z "$camera_model" ]]; then
        camera_model=$(get_exif_value "$exif_data" "Model" "")
    fi
    local film_sim_raw=$(get_exif_value "$exif_data" "FilmMode" "")
    local film_simulation=$(map_film_simulation "$film_sim_raw")

    # If FilmMode is empty, check Saturation field for B&W recipes
    if [[ -z "$film_simulation" ]]; then
        local saturation_raw=$(get_exif_value "$exif_data" "Saturation" "")
        film_simulation=$(map_saturation_bw "$saturation_raw")
    fi

    local wb_raw=$(get_exif_value "$exif_data" "WhiteBalance" "Auto")
    local white_balance=$(map_white_balance "$wb_raw")

    # For Kelvin/Temperature white balance, use ColorTemperature EXIF value
    local wb_temp
    if [[ "$white_balance" == "Temperature" ]]; then
        local color_temp=$(get_exif_value "$exif_data" "ColorTemperature" "5500")
        wb_temp="${color_temp}K"
    else
        wb_temp=$(get_exif_value "$exif_data" "WB_RGBLevels" "5500K")
    fi

    local wb_fine_tune=$(get_exif_value "$exif_data" "WhiteBalanceFineTune" "Red +0, Blue +0")
    local wb_shift_r=$(parse_wb_shift "$wb_fine_tune" "red")
    local wb_shift_b=$(parse_wb_shift "$wb_fine_tune" "blue")
    local exposure_bias=$(format_exposure_bias "$(extract_numeric "$(get_exif_value "$exif_data" "ExposureCompensation" "0" "false" "EXIF")")")

    # Try DevelopmentDynamicRange first, then AutoDynamicRange, strip % sign
    local dynamic_range=$(get_exif_value "$exif_data" "DevelopmentDynamicRange" "")
    if [[ -z "$dynamic_range" ]]; then
        dynamic_range=$(get_exif_value "$exif_data" "AutoDynamicRange" "100")
        dynamic_range="${dynamic_range%\%}"  # Strip percentage sign
    fi

    local highlight_tone=$(extract_numeric "$(get_exif_value "$exif_data" "HighlightTone" "0")")
    local shadow_tone=$(extract_numeric "$(get_exif_value "$exif_data" "ShadowTone" "0")")
    local color=$(extract_numeric "$(get_exif_value "$exif_data" "Saturation" "0")")
    local sharpness=$(extract_numeric "$(get_exif_value "$exif_data" "Sharpness" "0")")
    local noise_reduction=$(extract_numeric "$(get_exif_value "$exif_data" "NoiseReduction" "0")")
    local grain_effect=$(get_exif_value "$exif_data" "GrainEffectRoughness" "OFF" "true")
    local grain_size=$(get_exif_value "$exif_data" "GrainEffectSize" "OFF" "true")
    local color_chrome=$(get_exif_value "$exif_data" "ColorChromeEffect" "OFF" "true")
    local color_chrome_blue=$(get_exif_value "$exif_data" "ColorChromeFXBlue" "OFF" "true")
    local clarity=$(extract_numeric "$(get_exif_value "$exif_data" "Clarity" "0")")
    local bw_adjustment=$(extract_numeric "$(get_exif_value "$exif_data" "BWAdjustment" "0")")
    local bw_magenta_green=$(extract_numeric "$(get_exif_value "$exif_data" "BWMagentaGreen" "0")")

    # Extract filename without extension as label
    local filename=$(basename "$image_file")
    local label="${filename%.*}"

    # Generate serial number (placeholder - would need actual camera serial)
    local serial_number="000000000000000000000000000000"

    # Use Fuji Model for version, or format camera model as fallback
    local camera_version="$fuji_model"
    if [[ -z "$camera_version" ]]; then
        camera_version="${camera_model// /-}_0100"
    fi

    # Generate XML
    cat << EOF
<?xml version="1.0" encoding="utf-8"?>
<ConversionProfile application="XRFC" version="1.12.0.0">
    <PropertyGroup device="$camera_model" version="$camera_version" label="$label">
        <SerialNumber>$serial_number</SerialNumber>
        <TetherRAWConditonCode>${camera_version}</TetherRAWConditonCode>
        <Editable>TRUE</Editable>
        <SourceFileName/>
        <Fileerror>NONE</Fileerror>
        <RotationAngle>0</RotationAngle>
        <StructVer>65536</StructVer>
        <IOPCode>FF159509</IOPCode>
        <ShootingCondition>OFF</ShootingCondition>
        <FileType>JPG</FileType>
        <ImageSize>L3x2</ImageSize>
        <ImageQuality>Fine</ImageQuality>
        <ExposureBias>$exposure_bias</ExposureBias>
        <DynamicRange>$dynamic_range</DynamicRange>
        <WideDRange>0</WideDRange>
        <FilmSimulation>$film_simulation</FilmSimulation>
        <BlackImageTone>$bw_adjustment</BlackImageTone>
        <MonochromaticColor_RG>$bw_magenta_green</MonochromaticColor_RG>
        <GrainEffect>$grain_effect</GrainEffect>
        <GrainEffectSize>$grain_size</GrainEffectSize>
        <ChromeEffect>$color_chrome</ChromeEffect>
        <ColorChromeBlue>$color_chrome_blue</ColorChromeBlue>
        <SmoothSkinEffect>OFF</SmoothSkinEffect>
        <WBShootCond>OFF</WBShootCond>
        <WhiteBalance>$white_balance</WhiteBalance>
        <WBShiftR>$wb_shift_r</WBShiftR>
        <WBShiftB>$wb_shift_b</WBShiftB>
        <WBColorTemp>$wb_temp</WBColorTemp>
        <HighlightTone>$highlight_tone</HighlightTone>
        <ShadowTone>$shadow_tone</ShadowTone>
        <Color>$color</Color>
        <Sharpness>$sharpness</Sharpness>
        <NoisReduction>$noise_reduction</NoisReduction>
        <Clarity>$clarity</Clarity>
        <LensModulationOpt>ON</LensModulationOpt>
        <ColorSpace>sRGB</ColorSpace>
        <HDR/>
        <DigitalTeleConv>OFF</DigitalTeleConv>
        <PortraitEnhancer/>
    </PropertyGroup>
</ConversionProfile>
EOF
}

# Extract a field value from XML
extract_xml_field() {
    local xml_content="$1"
    local field_name="$2"

    echo "$xml_content" | grep -o "<${field_name}>[^<]*</${field_name}>" | sed "s/<${field_name}>//;s/<\/${field_name}>//"
}

# Get all FP1 files from X RAW STUDIO folder
get_fp1_files() {
    local xraw_dir="$HOME/Library/Application Support/com.fujifilm.denji/X RAW STUDIO"
    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local recipes_dir="$script_dir/Recipes"

    local found_files=""

    # Check X RAW STUDIO directory
    if [[ -d "$xraw_dir" ]]; then
        local xraw_files=$(find "$xraw_dir" -name "*.FP1" -type f 2>/dev/null || true)
        if [[ -n "$xraw_files" ]]; then
            found_files="$xraw_files"
        fi
    fi

    # Check local Recipes directory
    if [[ -d "$recipes_dir" ]]; then
        local recipe_files=$(find "$recipes_dir" -name "*.FP1" -type f 2>/dev/null || true)
        if [[ -n "$recipe_files" ]]; then
            if [[ -n "$found_files" ]]; then
                found_files="$found_files"$'\n'"$recipe_files"
            else
                found_files="$recipe_files"
            fi
        fi
    fi

    if [[ -z "$found_files" ]]; then
        echo "Warning: No FP1 files found" >&2
        echo "Searched locations:" >&2
        echo "  - $xraw_dir" >&2
        echo "  - $recipes_dir" >&2
        return 1
    fi

    echo "$found_files"
}

# Define mandatory fields that must match (all fields)
# GrainEffect, GrainEffectSize, and Clarity were removed from the mandatory fields because they are likely to be deleted by the user.
get_mandatory_fields() {
    cat << 'EOF'
FilmSimulation
WBShiftR
WBShiftB
WhiteBalance
WBColorTemp
ChromeEffect
ColorChromeBlue
HighlightTone
ShadowTone
DynamicRange
Color
Sharpness
NoisReduction
BlackImageTone
MonochromaticColor_RG
EOF
}

# Compare two values with fuzzy matching for numeric fields
values_match() {
    local field="$1"
    local val1="$2"
    local val2="$3"

    # Empty value handling
    if [[ -z "$val1" ]] && [[ -z "$val2" ]]; then
        return 0
    fi
    if [[ -z "$val1" ]] || [[ -z "$val2" ]]; then
        return 1
    fi

    # Exact match
    if [[ "$val1" == "$val2" ]]; then
        return 0
    fi

    # For numeric fields, allow small differences (e.g., 0 vs 0.0)
    if [[ "$val1" =~ ^-?[0-9]+\.?[0-9]*$ ]] && [[ "$val2" =~ ^-?[0-9]+\.?[0-9]*$ ]]; then
        local diff=$(echo "$val1 - $val2" | bc 2>/dev/null | tr -d '-')
        if (( $(echo "$diff < 0.1" | bc -l 2>/dev/null) )); then
            return 0
        fi
    fi

    return 1
}

# Compare generated XML with a recipe FP1 file
compare_recipes() {
    local generated_xml="$1"
    local recipe_file="$2"

    if [[ ! -f "$recipe_file" ]]; then
        echo "Error: Recipe file not found: $recipe_file" >&2
        return 1
    fi

    local recipe_xml=$(cat "$recipe_file")
    local recipe_name=$(basename "$recipe_file" .FP1)

    # Get mandatory fields
    local mandatory_fields=$(get_mandatory_fields)

    # Check all fields - all must match for 100% match
    while IFS= read -r field; do
        [[ -z "$field" ]] && continue

        # Skip WBColorTemp if WhiteBalance is not Temperature
        if [[ "$field" == "WBColorTemp" ]]; then
            local wb_value=$(extract_xml_field "$generated_xml" "WhiteBalance")
            if [[ "$wb_value" != "Temperature" ]]; then
                continue
            fi
        fi

        local generated_value=$(extract_xml_field "$generated_xml" "$field")
        local recipe_value=$(extract_xml_field "$recipe_xml" "$field")

        if ! values_match "$field" "$generated_value" "$recipe_value"; then
            # Field doesn't match - skip this recipe entirely
            return 0
        fi
    done <<< "$mandatory_fields"

    # All fields matched - output the recipe name
    echo "$recipe_name"
}

# Compare generated recipe with all FP1 files
compare_with_all_recipes() {
    local image_file="$1"

    # Generate XML from image (but don't show it)
    local generated_xml
    generated_xml=$(generate_fp1 "$image_file")

    # Get all FP1 files
    local fp1_files
    fp1_files=$(get_fp1_files)

    if [[ -z "$fp1_files" ]]; then
        echo "No FP1 recipe files found" >&2
        exit 1
    fi

    # Compare with each recipe, stop on first match
    while IFS= read -r recipe_file; do
        local result=$(compare_recipes "$generated_xml" "$recipe_file")
        if [[ -n "$result" ]]; then
            echo "$result"
            return 0
        fi
    done <<< "$fp1_files"
}

main() {
    local debug_flag=false
    local xml_flag=false
    local image_file=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                show_help
                exit 0
                ;;
            --xml)
                xml_flag=true
                shift
                ;;
            --debug)
                debug_flag=true
                shift
                ;;
            -*)
                echo "Error: Unknown option: $1" >&2
                echo "Use --help for usage information" >&2
                exit 1
                ;;
            *)
                if [[ -z "$image_file" ]]; then
                    image_file="$1"
                else
                    echo "Error: Multiple image files specified" >&2
                    exit 1
                fi
                shift
                ;;
        esac
    done

    # Validate arguments
    if [[ -z "$image_file" ]]; then
        echo "Error: No image file specified" >&2
        echo "Use --help for usage information" >&2
        exit 1
    fi

    # Check dependencies
    check_dependencies

    # Execute based on mode
    if [[ "$debug_flag" == true ]]; then
        debug_mode "$image_file"
    elif [[ "$xml_flag" == true ]]; then
        generate_fp1 "$image_file"
    else
        # Default behavior: compare with all recipes (100% match only)
        compare_with_all_recipes "$image_file"
    fi
}

main "$@"
